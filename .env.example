# Copy to .env and fill in. Never commit .env (scripts/secret_scan.py blocks it).

# GitHub
GH_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_BRANCH=main

# Supabase: management access (pipeline + setup, local machine only)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_ORG_ID=
SUPABASE_DB_PASSWORD=

# Supabase: application
# Safe for the browser
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# The local pipeline ONLY (push, the removal check): never the browser, never the site
SUPABASE_SECRET_KEY=
# The site's server functions ONLY (search, removal requests): a second secret key, made for the site alone so it
# can be revoked on its own. Hosted, it is a secret of the Cloudflare Pages project; here only for local runs.
# Never the browser.
SUPABASE_SERVER_KEY=

# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT_NAME=

# Development
APP_ENV=development
APP_BASE_URL=

# DeviantArt API (register an app at https://www.deviantart.com/developers/register)
DEVIANT_ART_ID=
DEVIANT_ART_SECRET=
