# Copy to .env and fill in. Never commit .env (scripts/secret_scan.py blocks it).

# GitHub
GH_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_BRANCH=main

# Supabase: management access (pipeline + setup, local machine only)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_ORG_ID=
SUPABASE_DB_PASSWORD=

# Supabase: application
# The address and the publishable key: the site's server functions and the pipeline's tests. Not secret, and alone
# they open nothing: the database lets the public role run only the site's functions, and those only with SITE_TOKEN.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# The local pipeline ONLY (push, the removal check): never the browser, never the site
SUPABASE_SECRET_KEY=
# The site's token: a long random string made once, for example with Python's secrets.token_urlsafe(32).
# `uv run python -m pipeline.db migrate` gives the database its hash. Hosted, it is a secret of the Cloudflare Pages
# project (npx wrangler pages secret put SITE_TOKEN --project-name artist-search). Never the browser.
SITE_TOKEN=

# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT_NAME=

# Development
APP_ENV=development
APP_BASE_URL=

# DeviantArt API (register an app at https://www.deviantart.com/developers/register)
DEVIANT_ART_ID=
DEVIANT_ART_SECRET=
